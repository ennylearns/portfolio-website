---
import LibraryWorkDetail from '../../../components/LibraryWorkDetail.astro';
import { getPublishedLibraryWork, type LibraryWork } from '../../../lib/library';

export async function getStaticPaths() {
  const works = await getPublishedLibraryWork();
  return works
    .filter((work) => work.kind === 'Essay')
    .map((work) => ({
      params: { slug: work.slug },
      props: { work },
    }));
}

interface Props {
  work: LibraryWork;
}

const { work } = Astro.props;
---

<LibraryWorkDetail work={work} />
