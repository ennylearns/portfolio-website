---
import BaseLayout from '../layouts/BaseLayout.astro';
import PrototypeCard from '../components/PrototypeCard.astro';
import SubscriberForm from '../components/SubscriberForm.astro';
import { siteConfig } from '../config/site';
import { getFeaturedPrototype } from '../lib/prototypes';

const featuredPrototype = await getFeaturedPrototype();
---

<BaseLayout
  title={siteConfig.title}
  description={siteConfig.description}
>
  <section aria-label="Introduction">
    <p class="lead">
      My name is Eniola Odunaiya and I believe AI is the key to exponential
      economic growth in Africa. I build and write about how practical AI
      improves daily life, strengthens businesses, and grows the economy in
      Nigeria and across Africa.
    </p>
  </section>

  {
    featuredPrototype && (
      <>
        <hr class="section-rule" />

        <section aria-labelledby="featured-prototype-heading">
          <p class="eyebrow" id="featured-prototype-heading">
            Featured Prototype
          </p>
          <PrototypeCard prototype={featuredPrototype} />
        </section>
      </>
    )
  }

  <hr class="section-rule" />

  <section aria-labelledby="bio-heading">
    <h2 id="bio-heading">Builder &amp; writer</h2>
    <p>
      I am an AI builder-writer based in Nigeria, focused on turning frontier
      software into dependable tools and step-by-step Playbooks for African
      founders, operators, and decision-makers.
    </p>
    <p>
      <a href="/about">Read more about my work and story</a>
    </p>
  </section>

  <hr class="section-rule" />

  <SubscriberForm idSuffix="home-subscriber" />
</BaseLayout>
