---
import type { CollectionEntry } from 'astro:content';

interface Props {
  prototype: CollectionEntry<'prototypes'>;
}

const { prototype } = Astro.props;
const href = `/prototypes/${prototype.id}`;
---

<div class="prototype-card">
  <div class="prototype-card__meta">
    <span class="scope-badge">{prototype.data.scope}</span>
  </div>
  <h2 class="prototype-card__title">
    <a href={href}>{prototype.data.title}</a>
  </h2>
  <p class="prototype-card__summary">{prototype.data.summary}</p>
  <p class="prototype-card__action">
    <a href={href}>Inspect Prototype</a>
  </p>
</div>
